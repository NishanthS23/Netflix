# Environment variables for Docker Compose setup

# Backend Configuration
SERVER_PORT=8000
NODE_ENV=production

# Frontend URL (accessible from browser)
CLIENT_URL=http://localhost

# Database connection string (internal Docker network service name 'db')
MONGO_URI=mongodb://db:27017/netflix

# JWT Secret for session authentication
JWT_SECRET=netflix_super_secret_jwt_key_2026

# TMDB API key (Required for fetching movies & tv shows: https://www.themoviedb.org/)
TMDB_API_KEY=your_tmdb_api_key_here

# Mailtrap credentials (Optional: used for signup/reset password emails)
MAILTRAP_TOKEN=your_mailtrap_token_here
MAILTRAP_ENDPOINT=https://sandbox.api.mailtrap.io/api/send/your_inbox_id
