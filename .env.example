# ==========================================
# Netflix Clone - Environment Variables Template
# Copy this file to .env and fill in real values
# ==========================================

# Application Settings
NODE_ENV=production
SERVER_PORT=8000
CLIENT_URL=http://localhost

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# AWS RDS PostgreSQL Configuration
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name?sslmode=require
DB_HOST=your_db_host_here
DB_PORT=5432
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here
DB_SSL=true

# SMTP Email Configuration (Nodemailer: Gmail / Mailtrap / SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="Netflix Clone <your_email@gmail.com>"

# Google OAuth Configuration (Google Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Docker Registry
DOCKERHUB_USERNAME=your_dockerhub_username_here


