{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3VideoBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::netflix-media-storage-530700193656",
        "arn:aws:s3:::netflix-media-storage-530700193656/*",
        "arn:aws:s3:::netflix-media-storage-09102026",
        "arn:aws:s3:::netflix-media-storage-09102026/*"
      ]
    }
  ]
}
