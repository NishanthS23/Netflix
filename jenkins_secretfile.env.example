# ==============================================================================
# Netflix Clone - Production Environment Secrets File (Jenkins Secret File)
# ==============================================================================
# INSTRUCTIONS FOR JENKINS:
# 1. Fill in your real production values in this file.
# 2. Save it as 'jenkins_secretfile.env' on your local machine.
# 3. In Jenkins UI:
#    - Navigate to: Dashboard -> Manage Jenkins -> Credentials -> System -> Global credentials
#    - Click "Add Credentials"
#    - Select Kind: "Secret file"
#    - File: Upload your completed 'jenkins_secretfile.env'
#    - ID: netflix-secret-file
#    - Description: Netflix Clone Production Secret File (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
SERVER_PORT=8000
# Set CLIENT_URL to your EC2 public IP or domain (e.g., http://13.201.134.195 or http://netflix.yourdomain.com)
CLIENT_URL=http://your_ec2_public_ip_or_domain

# ------------------------------------------------------------------------------
# 2. Authentication Secrets
# ------------------------------------------------------------------------------
# Generate a strong 64+ char random string (e.g., openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here

# ------------------------------------------------------------------------------
# 3. AWS RDS PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# AWS RDS PostgreSQL endpoint (e.g., netflix-db.cxxxxxxxx.ap-south-1.rds.amazonaws.com)
DB_HOST=your_aws_rds_endpoint_here
DB_PORT=5432
DB_USER=your_db_username_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here
DB_SSL=true

# Full PostgreSQL Connection URL (sslmode=require for AWS RDS)
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name?sslmode=require

# ------------------------------------------------------------------------------
# 4. Third-Party APIs (TMDB)
# ------------------------------------------------------------------------------
# TMDB API v3 Key for movies, TV series, trailers, and trending feeds
TMDB_API_KEY=your_tmdb_api_key_here

# ------------------------------------------------------------------------------
# 5. SMTP Email Configuration (Nodemailer: Gmail / Mailtrap / SES)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
# For Gmail: Use a 16-character App Password (Google Account -> Security -> App Passwords)
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="Netflix Clone <your_email@gmail.com>"

# ------------------------------------------------------------------------------
# 6. Google OAuth Configuration (Google Identity Services)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 7. Docker Registry Configuration
# ------------------------------------------------------------------------------
DOCKERHUB_USERNAME=your_dockerhub_username_here

# ------------------------------------------------------------------------------
# 8. AWS S3 Bucket Storage Configuration (Replaces Docker Volume)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here
